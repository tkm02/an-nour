# Copier en .env pour le développement. Ne jamais committer .env.
# Les variables REACT_APP_* sont incluses dans le code envoyé au navigateur : n'y mettre aucun secret.

# URL de base de l'API backend, SANS /api/v1 ni slash final (les chemins /api/v1/... sont ajoutés dans le code).
# Obligatoire au build de production (src/config.js lève une erreur explicite sinon) ; en développement et en
# test, sans valeur, repli sur http://localhost:8000 (API locale).
REACT_APP_API_URL=<url_de_l_api>

# Cloudinary (téléversement des reçus depuis le navigateur, preset NON signé : à restreindre côté Cloudinary)
REACT_APP_CLOUDINARY_CLOUD_NAME=<cloud_name>
REACT_APP_CLOUDINARY_UPLOAD_PRESET=<upload_preset>

# Recensement du CO (/recensement-co) : contact d'aide affiché aux membres (texte libre PUBLIC, ex. numéro
# WhatsApp de l'administration). Facultatif : sans valeur, le formulaire invite seulement à contacter l'administration.
REACT_APP_RECENSEMENT_CONTACT=<contact_d_aide_public>

# Clé d'API Cloudinary (identifiant public, pas le secret ; actuellement non lue par le code de src/)
REACT_APP_API_KEY=<api_key_cloudinary>
